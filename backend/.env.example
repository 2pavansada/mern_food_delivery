# ==============================================================================
# BITEZY BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Port (default 4000 locally; set automatically by Vercel/host in production)
PORT=4000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.exkxkun.mongodb.net/reactjs-food-delivery-app?retryWrites=true&w=majority

# JWT Authentication Secret Key (use a strong random 32+ character string)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Stripe Payments Secret Key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_placeholder

# Deployed URLs (Used for CORS and Stripe redirect URLs)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Optional: Persistent Cloud Image Storage via Cloudinary
# (Recommended for production on Vercel Serverless to persist uploaded food images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
