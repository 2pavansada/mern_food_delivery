# ==============================================================================
# BITEZY FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Backend API URL:
# - Leave empty ("") when using unified Vercel Services deployment (proxied via /api)
# - Set to full URL (e.g. https://api-yourproject.vercel.app) if backend is hosted separately
# - In local development without this variable, defaults to http://localhost:4000
VITE_API_URL=

# Admin Portal URL:
# - Set to /admin when using unified Vercel Services deployment
# - Set to full URL (e.g. https://admin-yourproject.vercel.app) if admin is hosted separately
# - In local development without this variable, defaults to http://localhost:5174
VITE_ADMIN_URL=/admin
