# ==============================================================================
# BITEZY ADMIN PORTAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Backend API URL:
# - Leave empty ("") when using unified Vercel Services deployment (proxied via /api)
# - Set to full URL (e.g. https://api-yourproject.vercel.app) if backend is hosted separately
# - In local development without this variable, defaults to http://localhost:4000
VITE_API_URL=

# Base Path for Vite and React Router:
# - Set to /admin when deployed under subpath /admin on unified domain
# - Set to / if deployed on dedicated custom domain/subdomain (e.g. https://admin.yourdomain.com)
VITE_BASE_PATH=/admin

# Storefront URL for "View Customer App" links:
# - Set to / when using unified Vercel Services deployment
# - Set to full URL (e.g. https://store-yourproject.vercel.app) if frontend is hosted separately
VITE_FRONTEND_URL=/
